# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit it.

# Flask secret key — generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-string

# Local development needs nothing else. Production settings must be supplied
# by the real environment because .env is not read when APP_ENV=production.
# See "Production Security Configuration" in README.md.
#
# Production variables (set in the service environment, not here):
#   APP_ENV=production
#   SECRET_KEY=<at least 32 random characters>
#   TRUSTED_HOSTS=helpdesk.example.org
#   TRUSTED_PROXY_COUNT=1
#   TRUSTED_PROXY_IPS=127.0.0.1
