# Weekly automated restoration drill: the newest backup is decrypted,
# restored into a disposable database, checked and deleted. The live
# database is never opened. Results: journalctl -u helpdesk-backup-drill
# and /var/backups/helpdesk/drills/. EXAMPLE ONLY - review before installing.

[Unit]
Description=IT Helpdesk backup restoration drill
OnFailure=helpdesk-alert@%n.service

[Service]
Type=oneshot
User=helpdesk
Group=helpdesk
WorkingDirectory=/opt/helpdesk/current
EnvironmentFile=/etc/helpdesk/helpdesk.env
LoadCredential=backup-key:/etc/helpdesk/credentials/backup-key
LoadCredential=secret-key:/etc/helpdesk/credentials/secret-key
LoadCredential=redis-uri:/etc/helpdesk/credentials/redis-uri
Environment=HELPDESK_BACKUP_KEY_FILE=%d/backup-key
Environment=SECRET_KEY_FILE=%d/secret-key
Environment=RATELIMIT_STORAGE_URI_FILE=%d/redis-uri

ExecStart=/opt/helpdesk/current/.venv/bin/flask --app app backup-drill
TimeoutStartSec=15min
Nice=10

UMask=0077
# The disposable copy goes to a private /tmp that is removed afterwards
PrivateTmp=yes
ReadWritePaths=/var/backups/helpdesk
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
# The drill needs no network at all
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
