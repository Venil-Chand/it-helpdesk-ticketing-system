# Non-secret production settings for the helpdesk services.
#
# Install as /etc/helpdesk/helpdesk.env, owned by root:helpdesk, mode 0640.
# Every helpdesk systemd unit reads this file with EnvironmentFile=.
#
# NO SECRETS IN THIS FILE. The secret key, the Redis password, the SMTP
# password and the backup encryption key are separate files under
# /etc/helpdesk/credentials/ (mode 0600, owner root), handed to each
# service by systemd's LoadCredential= and read through the *_FILE
# variables that the unit files set. See docs/PRODUCTION_OPERATIONS.md.

# --- Application ---------------------------------------------------------
APP_ENV=production

# The public name visitors use; must match the site name in the Caddyfile
TRUSTED_HOSTS=helpdesk.example.org

# Exactly one reverse proxy (Caddy) on this machine
TRUSTED_PROXY_COUNT=1
TRUSTED_PROXY_IPS=127.0.0.1

# The database lives outside the code directory, so a deployment or a
# rollback never touches it
HELPDESK_DATABASE_PATH=/var/lib/helpdesk/helpdesk.db

# --- Gunicorn -------------------------------------------------------------
HELPDESK_BIND=127.0.0.1:8000
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=30

# --- Notifications (worker only) -----------------------------------------
# Start with "local" (simulated: written to NOTIFICATION_SINK_DIR, never
# sent) and switch to smtp only after the provider decision is made.
NOTIFICATION_DELIVERY=local
NOTIFICATION_SINK_DIR=/var/lib/helpdesk/notification-sink
NOTIFICATION_BASE_URL=https://helpdesk.example.org
# NOTIFICATION_SENDER=helpdesk@example.org
# NOTIFICATION_SMTP_HOST=smtp.example.org
# NOTIFICATION_SMTP_PORT=587
# NOTIFICATION_SMTP_SECURITY=starttls
# NOTIFICATION_SMTP_USERNAME=helpdesk
#   (the password comes from NOTIFICATION_SMTP_PASSWORD_FILE, set by the
#    worker's unit file)

# --- Backups --------------------------------------------------------------
HELPDESK_BACKUP_DIR=/var/backups/helpdesk
# A second location on different hardware: a folder (owned by helpdesk,
# mode 0700) on a network share or disk mounted at /mnt/helpdesk-offsite.
# Leave unset until one exists. See docs/STAGING_RUNBOOK.md, phase 12.
# HELPDESK_BACKUP_OFFSITE_DIR=/mnt/helpdesk-offsite/helpdesk

# --- Monitoring -------------------------------------------------------------
HELPDESK_STATE_DIR=/var/lib/helpdesk/state
